# Copy to .env and fill in only the provider you intend to use.
# Module D auto-selects a provider based on which key is present.
# With no key set, the tool falls back to the offline rule-based reporter (stub).

# OpenAI (GPT-4o)
# OPENAI_API_KEY=sk-...

# Google Gemini
# GEMINI_API_KEY=...

# Anthropic (Claude)
# ANTHROPIC_API_KEY=sk-ant-...

# OpenAI-compatible endpoints (Kimi / Qwen / local, etc.)
# Set base_url + model in config/settings.yaml under reporting.openai_compatible
# OPENAI_COMPATIBLE_API_KEY=...
